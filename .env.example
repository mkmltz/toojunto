APP_ENV=development
POSTGRES_DB=toojunto
POSTGRES_USER=toojunto
POSTGRES_PASSWORD=toojunto_dev
DATABASE_URL=postgresql+psycopg://toojunto:toojunto_dev@db:5432/toojunto
JWT_SECRET=change-me-in-development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ENABLE_API_DOCS=true

# Production requires APP_ENV=production, a non-local PostgreSQL DATABASE_URL,
# a unique JWT_SECRET with at least 32 characters, and explicit ALLOWED_HOSTS.
# Use an empty CORS_ORIGINS when frontend and API share the same origin via /api.
# API documentation is disabled by default in production.
