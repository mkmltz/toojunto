# Copy to production.env and replace every placeholder before use.
# production.env is ignored by Git.
POSTGRES_DB=toojunto
POSTGRES_USER=toojunto
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+psycopg://toojunto:replace-with-url-encoded-password@db:5432/toojunto
JWT_SECRET=replace-me
CORS_ORIGINS=
ALLOWED_HOSTS=replace-with-domain-or-local-validation-host
ENABLE_API_DOCS=false
FRONTEND_PORT=8080
PUBLIC_APP_URL=https://replace-with-public-app-domain.example
SMTP_HOST=replace-with-smtp-host.example
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=replace-with-sender@example.com
SMTP_FROM_NAME=TooJunto
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
