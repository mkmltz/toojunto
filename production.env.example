# Copy to production.env and replace every placeholder before use.
# production.env is ignored by Git.
POSTGRES_DB=toojunto
POSTGRES_USER=toojunto
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+psycopg://toojunto:replace-with-url-encoded-password@db:5432/toojunto
JWT_SECRET=replace-me
CORS_ORIGINS=
ALLOWED_HOSTS=replace-with-domain-or-local-validation-host
ENABLE_API_DOCS=false
FRONTEND_PORT=8080
